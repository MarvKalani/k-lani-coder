# k-lani-ai-proxy configuration — copy to .env and fill in.
# The proxy talks to ONE upstream; your agents always talk to the proxy.

# 1) Pick an upstream (default: OpenAI). Examples:
#    OpenAI:      https://api.openai.com/v1/chat/completions
#    Anthropic:   https://api.anthropic.com/v1/messages   (see PROXY.md, auth passthrough)
#    Local llama: http://host.docker.internal:8001/v1/chat/completions
MKLANI_UPSTREAM_URL=https://api.openai.com/v1/chat/completions

# 2) Your API key for that upstream (never reaches the agents; masked in all logs).
#    Local llama-server needs none — leave it empty.
MKLANI_UPSTREAM_API_KEY=

# 3) Where the token/cost ledger lives (inside the container).
MKLANI_DATA_DIR=/data
